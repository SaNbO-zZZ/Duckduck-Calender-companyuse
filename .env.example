# Example values only. Keep credentials in the ignored local environment.
LOG_DIR=./logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# Local-only controlled duty notification simulation; never enable live sending here.
DUTY_TEST_MODE=simulate
# DUTY_TEST_RECIPIENT_ID=<stable-miaoda-user-id>

# Phase 1 server-side OAuth and Supabase. Use a random secret of at least 32 bytes.
APP_BASE_URL=https://calendar.alphapulsex.online
FEISHU_APP_ID=cli_aa35caedff78dcc5
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
SESSION_JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Import operator only. Use a TLS database connection for the intended project.
DATABASE_URL=
# Enable the Feishu login gate in local or preview Vite builds.
VITE_FEISHU_OAUTH=false

# Vercel server-side Base access and Supabase scheduler bearer secret.
FEISHU_BITABLE_APP_TOKEN=
CRON_SECRET=
