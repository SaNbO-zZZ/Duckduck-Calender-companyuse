{
  "rewrites": [
    {
      "source": "/api/calendar/:route+",
      "destination": "/api/calendar?route=:route"
    },
    {
      "source": "/api/duty/:route+",
      "destination": "/api/duty?route=:route"
    },
    {
      "source": "/charter",
      "destination": "/index.html"
    },
    {
      "source": "/duty-exchange",
      "destination": "/index.html"
    },
    {
      "source": "/release-announcement",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client"
}
